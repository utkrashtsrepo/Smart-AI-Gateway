# Smart AI Gateway Configuration

# Application Environment (development, testing, production)
APP_ENV=development

# Groq API Key (Optional: system automatically falls back to Mock provider if left empty)
GROQ_API_KEY=your_groq_api_key_here

# Provider Configuration
USE_MOCK_PROVIDER=false
CHEAP_MODEL=openai/gpt-oss-20b
STRONG_MODEL=openai/gpt-oss-120b
FALLBACK_MODEL=openai/gpt-oss-20b

# Cache Configuration
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=1000

# Reliability Configuration
MAX_RETRIES=3
BACKOFF_BASE_SECONDS=0.5

# Database Configuration
DATABASE_URL=data/gateway_logs.db

